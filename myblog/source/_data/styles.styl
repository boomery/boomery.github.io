// Fluid gradient background + refined article cards
// Injected via themes/next/_config.yml → custom_file_path.style

@keyframes fluid-drift-a
  0%, 100%
    transform: translate(0, 0) scale(1) rotate(0deg)
  25%
    transform: translate(6%, -4%) scale(1.08) rotate(2deg)
  50%
    transform: translate(-4%, 5%) scale(0.96) rotate(-1deg)
  75%
    transform: translate(3%, 3%) scale(1.04) rotate(1deg)

@keyframes fluid-drift-b
  0%, 100%
    transform: translate(0, 0) scale(1) rotate(0deg)
  33%
    transform: translate(-5%, 4%) scale(1.06) rotate(-2deg)
  66%
    transform: translate(4%, -3%) scale(0.98) rotate(2deg)

@keyframes hero-border-spin
  to
    transform: rotate(360deg)

@keyframes hero-scan
  0%
    top: -8%
    opacity: 0
  8%
    opacity: 0.55
  92%
    opacity: 0.55
  100%
    top: 108%
    opacity: 0

@keyframes hero-glow-pulse
  0%, 100%
    opacity: 0.65
    transform: scale(1)
  50%
    opacity: 1
    transform: scale(1.06)

@keyframes hero-fade-up
  from
    opacity: 0
    transform: translateY(22px)
  to
    opacity: 1
    transform: translateY(0)

@keyframes hero-shimmer
  0%
    background-position: 0% 50%
  100%
    background-position: 200% 50%

@keyframes grid-drift
  0%
    background-position: 0 0
  100%
    background-position: 48px 48px

@keyframes pulse-dot
  0%, 100%
    box-shadow: 0 0 0 0 rgba(74, 95, 212, 0.45)
  50%
    box-shadow: 0 0 0 7px rgba(74, 95, 212, 0)

@keyframes line-scan
  0%
    transform: translateY(-50%) translateX(-120%)
  100%
    transform: translateY(-50%) translateX(420%)

@keyframes tag-float
  0%, 100%
    transform: translateY(0)
  50%
    transform: translateY(-2px)

@keyframes hero-border-spin
  to
    transform: rotate(360deg)

@keyframes hero-scan
  0%
    top: -8%
    opacity: 0
  8%
    opacity: 0.55
  92%
    opacity: 0.55
  100%
    top: 108%
    opacity: 0

@keyframes hero-glow-pulse
  0%, 100%
    opacity: 0.65
    transform: scale(1)
  50%
    opacity: 1
    transform: scale(1.06)

@keyframes hero-fade-up
  from
    opacity: 0
    transform: translateY(22px)
  to
    opacity: 1
    transform: translateY(0)

@keyframes hero-shimmer
  0%
    background-position: 0% 50%
  100%
    background-position: 200% 50%

@keyframes grid-drift
  0%
    background-position: 0 0
  100%
    background-position: 48px 48px

@keyframes pulse-dot
  0%, 100%
    opacity: 1
    box-shadow: 0 0 0 0 rgba(74, 95, 212, 0.45)
  50%
    opacity: 0.55
    box-shadow: 0 0 0 5px rgba(74, 95, 212, 0)

@keyframes line-scan
  0%
    transform: translateY(-50%) translateX(-120%)
  100%
    transform: translateY(-50%) translateX(420%)

@keyframes tag-float
  0%, 100%
    transform: translateY(0)
  50%
    transform: translateY(-2px)

// ── Fluid background ──
body
  background: var(--body-bg-color)

  &::before,
  &::after
    content: ''
    position: fixed
    left: 0
    top: 0
    width: 100%
    height: 100%
    z-index: -1
    pointer-events: none
    filter: blur(90px)
    will-change: transform

  &::before
    background: radial-gradient(ellipse 55% 45% at 25% 35%, rgba(180, 200, 255, 0.55) 0%, transparent 70%),
                radial-gradient(ellipse 50% 40% at 75% 65%, rgba(220, 190, 255, 0.45) 0%, transparent 70%),
                radial-gradient(ellipse 45% 50% at 50% 90%, rgba(255, 210, 190, 0.35) 0%, transparent 70%)
    animation: fluid-drift-a 22s ease-in-out infinite
    opacity: 0.85

  &::after
    background: radial-gradient(ellipse 50% 45% at 80% 25%, rgba(190, 230, 255, 0.4) 0%, transparent 70%),
                radial-gradient(ellipse 55% 40% at 15% 75%, rgba(200, 180, 255, 0.35) 0%, transparent 70%)
    animation: fluid-drift-b 28s ease-in-out infinite
    opacity: 0.7

// ── Header / Nav ──
$header-height = 60px

html
  overflow-x: hidden
  max-width: 100%

body
  overflow-x: hidden
  max-width: 100%

.header
  background: rgba(255, 255, 255, 0.94) !important
  border-bottom: 1px solid rgba(255, 255, 255, 0.6)
  box-shadow: 0 2px 16px rgba(100, 120, 180, 0.08)
  margin-bottom: 32px
  position: sticky
  top: 0
  width: 100%
  z-index: 1300

.header-inner
  align-items: center
  box-sizing: border-box
  margin: 0 !important
  max-width: none !important
  padding: 16px 40px !important
  width: 100% !important

.brand
  border-bottom: none !important
  padding: 0 !important

.site-title
  font-weight: 800 !important
  font-size: 1.2rem !important
  letter-spacing: -0.03em

.site-subtitle
  color: #888 !important
  font-size: 0.72rem !important
  font-weight: 500
  letter-spacing: 0.06em
  margin-top: 2px !important

.site-meta
  text-align: left

.logo-line
  display: none

.site-nav .menu
  padding: 0
  text-align: right

  .menu-item
    margin: 0 2px

    a
      border-bottom: none !important
      border-radius: 8px
      color: #666 !important
      font-size: 0.88rem
      font-weight: 500
      letter-spacing: 0.02em
      padding: 8px 14px !important
      transition: background 0.2s, color 0.2s

      &:hover
        background: rgba(74, 95, 212, 0.08) !important
        color: #4a5fd4 !important

      &.menu-item-active
        background: rgba(74, 95, 212, 0.12) !important
        color: #4a5fd4 !important
        font-weight: 600

.main-inner
  padding-top: 4px

.main-inner.index
  overflow-x: hidden
  width: 100%
  max-width: 100%
  box-sizing: border-box

  &::before
    animation: grid-drift 24s linear infinite
    background-image: linear-gradient(rgba(74, 95, 212, 0.07) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(74, 95, 212, 0.07) 1px, transparent 1px)
    background-size: 48px 48px
    content: ''
    inset: 0
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 20%, transparent 75%)
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 20%, transparent 75%)
    pointer-events: none
    position: fixed
    z-index: -1

.posts-expand.index .post-block
  animation: hero-fade-up 0.65s ease both

  &:nth-child(1)
    animation-delay: 0.07s
  &:nth-child(2)
    animation-delay: 0.14s
  &:nth-child(3)
    animation-delay: 0.21s
  &:nth-child(4)
    animation-delay: 0.28s
  &:nth-child(5)
    animation-delay: 0.35s
  &:nth-child(6)
    animation-delay: 0.42s
  &:nth-child(7)
    animation-delay: 0.49s
  &:nth-child(8)
    animation-delay: 0.56s
  &:nth-child(9)
    animation-delay: 0.63s
  &:nth-child(10)
    animation-delay: 0.7s
  &:nth-child(11)
    animation-delay: 0.77s
  &:nth-child(12)
    animation-delay: 0.84s

// ── Sidebar / TOC（overlay 模式，不推挤页面） ──
$sidebar-glass-width = 320px

// 遮罩只盖住主内容区，不挡在侧边栏下方，否则 backdrop-filter 只会模糊黑遮罩
.sidebar-dimmer
  background: rgba(26, 26, 46, 0.28) !important
  left: $sidebar-glass-width !important
  width: calc(100% - $sidebar-glass-width) !important

  .sidebar-active &
    opacity: 1 !important

+desktop()
  .sidebar-active
    padding-left: 0 !important

  .sidebar-dimmer
    display: block
    z-index: 1190

.sidebar
  background: rgba(255, 255, 255, 0.52) !important
  backdrop-filter: blur(32px) saturate(1.8)
  -webkit-backdrop-filter: blur(32px) saturate(1.8)
  border-right: 1px solid rgba(255, 255, 255, 0.55)
  box-shadow: 4px 0 28px rgba(100, 120, 180, 0.12) !important
  height: 100vh !important
  left: 0 - $sidebar-desktop !important
  top: 0 !important
  z-index: 1200
  -webkit-transform: translateZ(0)
  transform: translateZ(0)

body.sidebar-active .sidebar
  left: 0 !important

.sidebar
  a
    border-bottom: none !important

  .sidebar-inner
    color: #666
    max-height: calc(100vh - $header-height - 24px) !important
    padding-top: ($header-height + 12px) !important

  .sidebar-nav li
    color: #888
    font-size: 0.75rem
    font-weight: 600
    letter-spacing: 0.1em
    text-transform: uppercase

    &:hover
      color: #4a5fd4

  .sidebar-toc-active .sidebar-nav-toc,
  .sidebar-overview-active .sidebar-nav-overview
    border-bottom-color: #4a5fd4
    color: #4a5fd4

  .post-toc
    text-align: left

    ol
      padding: 0 4px 8px 0 !important

    .nav-item
      line-height: 1.55 !important
      margin-bottom: 2px
      white-space: normal !important

    a
      border-bottom: none !important
      border-radius: 5px
      color: #555 !important
      display: block
      font-size: 0.82rem
      padding: 4px 8px
      transition: background 0.15s, color 0.15s

      &:hover
        background: rgba(74, 95, 212, 0.08) !important
        color: #4a5fd4 !important

    .nav .active > a,
    .nav .active-current > a
      background: rgba(74, 95, 212, 0.12) !important
      color: #4a5fd4 !important
      font-weight: 600

// ── Category / Archive timeline ──
.posts-collapse .collection-header
  color: #1a1a2e
  font-size: 1.4rem
  font-weight: 700

  small
    color: #999
    font-size: 0.75rem
    font-weight: 500
    margin-left: 8px

.posts-collapse .collection-year
  color: #4a5fd4
  font-size: 1.1rem
  font-weight: 700
  margin: 36px 0 16px

.posts-collapse .post-header
  border-bottom-color: rgba(0, 0, 0, 0.07) !important
  margin-top: 20px !important
  padding-bottom: 10px

  &:hover
    border-bottom-color: rgba(74, 95, 212, 0.25) !important

.posts-collapse .post-content::before
  background: rgba(74, 95, 212, 0.15) !important

// ── Article cards ──
.post-block
  background: rgba(255, 255, 255, 0.88) !important
  backdrop-filter: blur(20px) saturate(1.4)
  -webkit-backdrop-filter: blur(20px) saturate(1.4)
  border: 1px solid rgba(255, 255, 255, 0.65)
  border-radius: 16px
  box-shadow: 0 4px 24px rgba(100, 120, 180, 0.1),
              0 1px 3px rgba(0, 0, 0, 0.04)
  padding: 36px 40px
  transition: box-shadow 0.3s ease, transform 0.3s ease

  &:hover
    box-shadow: 0 8px 32px rgba(100, 120, 180, 0.16),
                0 2px 6px rgba(0, 0, 0, 0.06)
    transform: translateY(-2px)

.posts-expand .post-block:not(:first-child)
  margin-top: 28px !important

.posts-expand.index .post-header
  margin-bottom: 16px !important
  text-align: left

.posts-expand .post-title
  font-size: 1.45rem !important
  font-weight: 700 !important
  letter-spacing: -0.02em
  line-height: 1.35

.posts-expand .post-title-link
  color: #1a1a2e !important

  &::before
    display: none

  &:hover
    color: #4a5fd4 !important

.posts-expand .post-meta-container
  margin-top: 10px !important
  color: #888 !important

  time
    border-bottom: none !important
    background: rgba(0, 0, 0, 0.04)
    border-radius: 4px
    padding: 2px 7px

.post-meta-item-icon
  color: #aaa

.post-body
  color: #444
  line-height: 1.85
  font-size: 0.95rem
  margin-top: 4px

  p
    margin-bottom: 14px

  h2, h3, h4
    color: #1a1a2e
    margin-top: 28px
    margin-bottom: 12px

.post-button
  margin-top: 24px !important

  .btn
    display: inline-block
    background: rgba(74, 95, 212, 0.08) !important
    border: 1px solid rgba(74, 95, 212, 0.2) !important
    border-bottom: 1px solid rgba(74, 95, 212, 0.2) !important
    border-radius: 8px
    color: #4a5fd4 !important
    font-size: 0.85rem
    font-weight: 600
    letter-spacing: 0.03em
    padding: 8px 18px !important
    transition: background 0.2s, border-color 0.2s, color 0.2s

    &:hover
      background: rgba(74, 95, 212, 0.15) !important
      border-color: rgba(74, 95, 212, 0.4) !important
      color: #3a4fc4 !important

.posts-expand .post-tags a
  background: rgba(0, 0, 0, 0.05) !important
  border-radius: 4px
  font-size: 0.82rem

  &:hover
    background: rgba(74, 95, 212, 0.1) !important

// ── Homepage Hero ──
.home-hero
  position: relative
  margin: 0 auto 36px
  max-width: 860px
  overflow: hidden
  min-height: 320px
  border-radius: 22px

.home-hero__particles
  inset: 0
  pointer-events: none
  position: absolute
  z-index: 2
  opacity: 0.85

.home-hero__grid
  background-image: linear-gradient(rgba(74, 95, 212, 0.09) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(74, 95, 212, 0.09) 1px, transparent 1px)
  background-size: 32px 32px
  animation: grid-drift 18s linear infinite
  inset: 0
  mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, black, transparent)
  -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, black, transparent)
  pointer-events: none
  position: absolute
  z-index: 1

.home-hero__glow
  animation: hero-glow-pulse 5s ease-in-out infinite
  background: radial-gradient(ellipse 70% 60% at 30% 20%, rgba(74, 95, 212, 0.22) 0%, transparent 70%),
              radial-gradient(ellipse 50% 50% at 80% 80%, rgba(140, 100, 255, 0.18) 0%, transparent 70%),
              radial-gradient(ellipse 40% 40% at 60% 30%, rgba(100, 200, 255, 0.12) 0%, transparent 70%)
  inset: -20%
  pointer-events: none
  position: absolute
  z-index: 0

.home-hero__scanline
  animation: hero-scan 5.5s ease-in-out infinite
  background: linear-gradient(to bottom, transparent, rgba(74, 95, 212, 0.18), transparent)
  border-radius: inherit
  height: 40%
  left: 0
  pointer-events: none
  position: absolute
  right: 0
  z-index: 4

.home-hero__inner
  animation: hero-fade-up 0.75s cubic-bezier(.22,.68,0,1.05) both
  backdrop-filter: blur(24px) saturate(1.5)
  -webkit-backdrop-filter: blur(24px) saturate(1.5)
  background: rgba(255, 255, 255, 0.74)
  border: 1px solid rgba(255, 255, 255, 0.75)
  border-radius: 20px
  box-shadow: 0 8px 40px rgba(74, 95, 212, 0.14),
              0 2px 8px rgba(0, 0, 0, 0.04),
              inset 0 1px 0 rgba(255, 255, 255, 0.8)
  isolation: isolate
  padding: 44px 48px 40px
  position: relative
  text-align: left
  z-index: 5

  &::before
    animation: hero-shimmer 5s linear infinite
    background: linear-gradient(90deg, rgba(74, 95, 212, 0.55), rgba(140, 100, 255, 0.45), rgba(100, 180, 255, 0.4), rgba(74, 95, 212, 0.55))
    background-size: 300% 100%
    border-radius: 22px
    content: ''
    inset: -2px
    pointer-events: none
    position: absolute
    z-index: -1

.home-hero__badge
  align-items: center
  animation: hero-fade-up 0.75s ease 0.1s both
  background: rgba(74, 95, 212, 0.1)
  border: 1px solid rgba(74, 95, 212, 0.25)
  border-radius: 999px
  color: #4a5fd4
  display: inline-flex
  font-size: 0.72rem
  font-weight: 700
  gap: 7px
  letter-spacing: 0.12em
  margin-bottom: 18px
  padding: 6px 14px 6px 10px
  text-transform: uppercase

.home-hero__badge-dot
  animation: pulse-dot 2s ease infinite
  background: #4a5fd4
  border-radius: 50%
  display: inline-block
  flex-shrink: 0
  height: 7px
  width: 7px

.home-hero__title
  animation: hero-fade-up 0.75s ease 0.18s both
  color: #1a1a2e
  font-size: 2rem
  font-weight: 800
  letter-spacing: -0.03em
  line-height: 1.25
  margin: 0 0 16px

.home-hero__accent
  background: linear-gradient(90deg, #4a5fd4, #8b5cf6, #4a9fd4, #4a5fd4)
  background-size: 200% auto
  -webkit-background-clip: text
  background-clip: text
  animation: hero-shimmer 4s linear infinite
  -webkit-text-fill-color: transparent

.home-hero__desc
  animation: hero-fade-up 0.75s ease 0.26s both
  color: #555
  font-size: 0.98rem
  line-height: 1.85
  margin: 0 0 28px
  max-width: 640px

.home-hero__actions
  animation: hero-fade-up 0.75s ease 0.34s both
  display: flex
  flex-wrap: wrap
  gap: 10px
  margin-bottom: 24px

.home-hero__btn
  border-radius: 10px
  box-sizing: border-box
  font-size: 0.88rem
  font-weight: 600
  letter-spacing: 0.02em
  max-width: 100%
  padding: 10px 20px
  position: relative
  text-decoration: none !important
  transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s, box-shadow 0.2s

  &:hover
    transform: translateY(-1px)

.home-hero__btn--primary
  background: linear-gradient(135deg, #4a5fd4, #5a4fd4) !important
  border: 1px solid rgba(74, 95, 212, 0.5) !important
  box-shadow: 0 4px 20px rgba(74, 95, 212, 0.28)
  color: #fff !important
  overflow: hidden

  &::after
    animation: hero-shimmer 3s linear infinite
    background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.25) 50%, transparent 60%)
    content: ''
    inset: 0
    position: absolute

  &:hover
    background: linear-gradient(135deg, #3a4fc4, #4a3fc4) !important
    box-shadow: 0 6px 28px rgba(74, 95, 212, 0.38)
    color: #fff !important

.home-hero__btn--ghost
  background: rgba(74, 95, 212, 0.07) !important
  border: 1px solid rgba(74, 95, 212, 0.18) !important
  color: #4a5fd4 !important

  &:hover
    background: rgba(74, 95, 212, 0.14) !important
    border-color: rgba(74, 95, 212, 0.35) !important
    box-shadow: 0 0 16px rgba(74, 95, 212, 0.12)
    color: #3a4fc4 !important

.home-hero__tags
  animation: hero-fade-up 0.75s ease 0.42s both
  display: flex
  flex-wrap: wrap
  gap: 8px
  list-style: none
  margin: 0
  padding: 0

  li
    animation: tag-float 3s ease-in-out infinite
    background: rgba(74, 95, 212, 0.06)
    border: 1px solid rgba(74, 95, 212, 0.1)
    border-radius: 6px
    color: #777
    font-size: 0.78rem
    font-weight: 500
    padding: 4px 10px

    &:nth-child(2)
      animation-delay: 0.4s

    &:nth-child(3)
      animation-delay: 0.8s

.home-posts-label
  align-items: center
  animation: hero-fade-up 0.6s ease 0.5s both
  color: #999
  display: flex
  font-size: 0.72rem
  font-weight: 700
  gap: 8px
  letter-spacing: 0.14em
  margin: 0 auto 20px
  max-width: 860px
  overflow: hidden
  position: relative
  text-align: left
  text-transform: uppercase
  width: 100%
  box-sizing: border-box

  &__dot
    animation: pulse-dot 2.2s ease infinite
    background: #4a5fd4
    border-radius: 50%
    flex-shrink: 0
    height: 6px
    width: 6px

  &::after
    background: rgba(74, 95, 212, 0.15)
    content: ''
    display: block
    flex: 1
    height: 1px
    margin-top: 0
    min-width: 0
    overflow: hidden
    position: relative

  &::before
    animation: line-scan 3.5s ease-in-out infinite
    background: linear-gradient(90deg, transparent, rgba(74, 95, 212, 0.8), transparent)
    content: ''
    height: 1px
    left: 0
    pointer-events: none
    position: absolute
    top: 50%
    transform: translateY(-50%)
    width: 28%
    will-change: transform

// ── Footer ──
.footer
  background: rgba(255, 255, 255, 0.6) !important
  backdrop-filter: blur(12px)
  -webkit-backdrop-filter: blur(12px)
  border-top: 1px solid rgba(255, 255, 255, 0.5)
  margin-top: 40px

// ── Mobile ──
+tablet-mobile()
  .sidebar-dimmer
    left: 0 !important
    width: 100% !important

  .sidebar
    background: rgba(255, 255, 255, 0.45) !important
    backdrop-filter: blur(40px) saturate(2)
    -webkit-backdrop-filter: blur(40px) saturate(2)
    box-shadow: 4px 0 36px rgba(100, 120, 180, 0.18) !important

+mobile()
  .main-inner
    max-width: 100% !important
    width: 100% !important
    box-sizing: border-box

  .header
    margin-bottom: 20px

  .header-inner
    padding: 12px 20px !important

  .site-nav .menu
    text-align: left

    .menu-item a
      padding: 10px 12px !important

  .post-block
    padding: 24px 20px
    border-radius: 12px

  .posts-expand.index .post-header
    text-align: left

  .home-hero__inner
    padding: 28px 22px 26px

  .home-hero__title
    font-size: 1.55rem

  .home-hero__desc
    font-size: 0.92rem

  .home-hero__actions
    flex-direction: column
    width: 100%

  .home-hero__btn
    display: block
    max-width: 100%
    text-align: center
    width: 100%

// ── Dark mode ──
@media (prefers-color-scheme: dark)
  body::before
    background: radial-gradient(ellipse 55% 45% at 25% 35%, rgba(60, 80, 140, 0.45) 0%, transparent 70%),
                radial-gradient(ellipse 50% 40% at 75% 65%, rgba(90, 60, 130, 0.35) 0%, transparent 70%),
                radial-gradient(ellipse 45% 50% at 50% 90%, rgba(100, 70, 60, 0.25) 0%, transparent 70%)

  body::after
    background: radial-gradient(ellipse 50% 45% at 80% 25%, rgba(50, 90, 120, 0.35) 0%, transparent 70%),
                radial-gradient(ellipse 55% 40% at 15% 75%, rgba(70, 55, 110, 0.3) 0%, transparent 70%)

  .post-block
    background: rgba(22, 22, 32, 0.85) !important
    border-color: rgba(255, 255, 255, 0.08)
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3)

  .posts-expand .post-title-link
    color: #e8e8f0 !important

    &:hover
      color: #8b9dff !important

  .post-body
    color: #bbb

  .post-meta-container time
    background: rgba(255, 255, 255, 0.06)

  .footer
    background: rgba(22, 22, 32, 0.7) !important

  .header
    background: rgba(22, 22, 32, 0.94) !important
    border-bottom-color: rgba(255, 255, 255, 0.06)

  .home-hero__inner
    background: rgba(22, 22, 32, 0.82)
    border-color: rgba(255, 255, 255, 0.08)
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.06)

  .home-hero__grid
    background-image: linear-gradient(rgba(139, 157, 255, 0.08) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(139, 157, 255, 0.08) 1px, transparent 1px)

  .main-inner.index::before
    background-image: linear-gradient(rgba(139, 157, 255, 0.06) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(139, 157, 255, 0.06) 1px, transparent 1px)

  .home-hero__title
    color: #e8e8f0

  .home-hero__desc
    color: #aaa

  .home-hero__badge
    background: rgba(139, 157, 255, 0.12)
    border-color: rgba(139, 157, 255, 0.25)
    color: #8b9dff

  .home-hero__btn--primary
    background: #5a6fe0 !important
    border-color: #5a6fe0 !important

  .home-hero__btn--ghost
    background: rgba(139, 157, 255, 0.1) !important
    border-color: rgba(139, 157, 255, 0.2) !important
    color: #8b9dff !important

  .home-hero__accent
    background: linear-gradient(90deg, #8b9dff, #b794f6, #6ecfff, #8b9dff)
    background-size: 200% auto
    -webkit-background-clip: text
    background-clip: text
    -webkit-text-fill-color: transparent

  .home-hero__tags li
    background: rgba(139, 157, 255, 0.08)
    border-color: rgba(139, 157, 255, 0.12)
    color: #888

  .home-posts-label
    color: #666

  .sidebar
    background: rgba(22, 22, 32, 0.55) !important
    backdrop-filter: blur(32px) saturate(1.8)
    -webkit-backdrop-filter: blur(32px) saturate(1.8)
    border-right-color: rgba(255, 255, 255, 0.08)

    .sidebar-inner
      color: #aaa

    .sidebar-nav li
      color: #777

      &:hover
        color: #8b9dff

    .post-toc a
      color: #aaa !important

      &:hover
        color: #8b9dff !important
        background: rgba(139, 157, 255, 0.1) !important

    .nav .active > a,
    .nav .active-current > a
      color: #8b9dff !important
      background: rgba(139, 157, 255, 0.12) !important

  .sidebar-dimmer
    background: rgba(0, 0, 0, 0.35) !important

  .site-nav .menu .menu-item a
    color: #aaa !important

    &:hover,
    &.menu-item-active
      color: #8b9dff !important

  .posts-collapse .collection-header
    color: #e8e8f0

  .posts-collapse .collection-year
    color: #8b9dff

@media (prefers-reduced-motion: reduce)
  body::before,
  body::after
    animation: none

  .main-inner.index::before,
  .home-hero__grid,
  .home-hero__glow,
  .home-hero__scanline,
  .home-hero__inner::before,
  .home-hero__accent,
  .home-hero__badge-dot,
  .home-posts-label__dot,
  .home-posts-label::before,
  .home-hero__btn--primary::after,
  .home-hero__tags li,
  .posts-expand.index .post-block,
  .home-hero__inner,
  .home-hero__badge,
  .home-hero__title,
  .home-hero__desc,
  .home-hero__actions,
  .home-hero__tags,
  .home-posts-label
    animation: none !important

  .post-block
    transition: none

    &:hover
      transform: none
